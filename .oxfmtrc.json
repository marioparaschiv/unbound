{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": true,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"bracketSpacing": true,
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 100,
	"trailingComma": "all",
	"ignorePatterns": [
		"*.gen.ts",
		"**/src/unbound-settings.d.ts",
		"**/src/unbound-i18n.d.ts",
		"packages/client/src/i18n/core-messages.d.ts",
		"drizzle",
		"packages/discord-types/src/**",
		"packages/cli/templates/**",
		"packages/cli/tests/fixtures/migrate-entry/**",
		"CHANGELOG.md",
		"docs/**/*.mdx",
		"packages/loader/bootstrap/devtools.js",
		"apps/devtools/target/**",
		"packages/loader/vendor/**",
		"packages/loader/apt-repo/**",
		"packages/loader/ios/.theos/**",
		"packages/loader/ios/packages/**",
		"packages/loader/android/**/build/**",
		"packages/loader/build/**",
		"packages/loader/ios/extensions/**",
		"packages/loader/tools/assets/**"
	]
}
