{
	"name": "unbound",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/client",
			"packages/cli",
			"packages/debugger",
			"packages/debugger-protocol",
			"packages/types",
			"packages/discord-types",
			"packages/api",
			"apps/sdk-generator",
			"apps/discord-typegen",
			"apps/web",
			"apps/discord-bot",
			"packages/contracts",
			"packages/plugin-test",
			"packages/utils",
			"packages/logger",
			"packages/client/scripts/build",
			"packages/client/scripts/serve",
			"packages/client/scripts/dev",
			"packages/plugins",
			"packages/plugins/*",
			"packages/plugins/shared/*",
			"packages/plugins-shared",
			"packages/plugin-scripts"
		],
		"catalog": {
			"typescript": "^5.9.3",
			"possess": "^1.1.0",
			"@types/bun": "latest",
			"better-auth": "1.7.12"
		},
		"catalogs": {
			"react": {
				"@types/react": "^19.2.7",
				"@types/react-dom": "^19.2.3",
				"react": "^19.3.1",
				"react-dom": "^19.3.1",
				"react-native": "^0.86.0"
			}
		}
	},
	"scripts": {
		"prepare": "lefthook install --reset-hooks-path",
		"generate-sdk": "bun apps/sdk-generator/src/index.ts",
		"generate-discord-types": "bun apps/discord-typegen/src/index.ts",
		"test:s3": "bun scripts/test-s3.ts",
		"lint": "bun run lint:js && bun run loader:lint",
		"lint:js": "bun run lint:rules && bun run --filter @unbound-app/web build:types && oxlint --config .oxlintrc.json --type-aware apps packages && bun run plugins:lint",
		"typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/discord-bot typecheck && bun run --cwd packages/cli typecheck && bun run --cwd packages/client typecheck && bun run --cwd packages/plugin-scripts typecheck",
		"lint:fix": "bun run lint:rules && bun run --filter @unbound-app/web build:types && oxlint --config .oxlintrc.json --type-aware --fix-dangerously apps packages",
		"lint:rules": "oxc-config-check .oxlintrc.json",
		"fmt": "bun run fmt:js && bun run loader:fmt",
		"fmt:js": "oxfmt --config .oxfmtrc.json apps packages",
		"fmt:check": "bun run fmt:js:check && bun run loader:fmt:check",
		"fmt:js:check": "oxfmt --config .oxfmtrc.json --check apps packages",
		"plugins:validate": "bun packages/plugin-scripts/src/validate-plugins.ts",
		"loader": "go -C packages/loader run ./tools",
		"loader:validate": "go -C packages/loader run ./tools validate",
		"loader:fmt": "go -C packages/loader run ./tools format",
		"loader:fmt:check": "go -C packages/loader run ./tools format --check",
		"loader:lint": "go -C packages/loader run ./tools lint",
		"loader:test": "go -C packages/loader test -count=1 ./tools && go -C packages/loader/workflow-tests test -count=1 ./...",
		"plugins:test": "bun test --isolate packages/plugins packages/plugins-shared packages/plugin-scripts",
		"plugins:lint": "bun run --filter @unbound-app/plugins --filter @unbound-app/plugin-scripts lint",
		"plugins:build": "cd packages/plugins && bun run build",
		"plugins:catalog": "bun packages/plugin-scripts/src/generate-plugins-readme.ts",
		"plugins:sync-icons": "bun packages/plugin-scripts/src/sync-plugin-icons.ts",
		"plugins:device-matrix": "bun packages/plugin-scripts/src/device-matrix.ts",
		"plugins:collect-device-matrix": "bun packages/plugin-scripts/src/collect-device-matrix.ts",
		"release": "semantic-release"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.2",
		"@marioparaschiv/oxc-config": "^0.2.0",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"dts-bundle-generator": "^9.5.1",
		"eslint-plugin-jsdoc": "^65.4.2",
		"eslint-plugin-perfectionist": "^5.9.1",
		"eslint-plugin-unicorn": "^79.0.0",
		"lefthook": "^2.1.9",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"semantic-release": "^25.0.8",
		"ts-morph": "^28.0.0"
	},
	"overrides": {
		"typescript": "5.9.3"
	},
	"patchedDependencies": {
		"possess@1.1.0": "patches/possess@1.1.0.patch"
	},
	"trustedDependencies": [
		"lefthook"
	]
}
