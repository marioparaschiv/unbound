{
	"name": "unbound",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/client",
			"packages/cli",
			"packages/debugger",
			"packages/debugger-protocol",
			"packages/types",
			"packages/api",
			"apps/sdk-generator",
			"apps/web",
			"packages/contracts",
			"packages/plugin-test",
			"packages/utils",
			"packages/logger",
			"packages/client/scripts/build",
			"packages/client/scripts/serve",
			"packages/client/scripts/dev"
		],
		"catalog": {
			"typescript": "^5.9.3",
			"possess": "^1.1.0",
			"@types/bun": "latest",
			"better-auth": "1.7.10"
		},
		"catalogs": {
			"react": {
				"@types/react": "^19.2.7",
				"@types/react-dom": "^19.2.3",
				"react": "^19.3.1",
				"react-dom": "^19.3.1",
				"react-native": "^0.83.0"
			}
		}
	},
	"scripts": {
		"prepare": "lefthook install --reset-hooks-path",
		"generate-sdk": "bun apps/sdk-generator/src/index.ts",
		"test:s3": "bun scripts/test-s3.ts",
		"lint": "bun run lint:rules && oxlint --config .oxlintrc.json --type-aware apps packages",
		"lint:fix": "bun run lint:rules && oxlint --config .oxlintrc.json --type-aware --fix-dangerously apps packages",
		"lint:rules": "oxc-config-check .oxlintrc.json",
		"fmt": "oxfmt --config .oxfmtrc.json apps packages",
		"fmt:check": "oxfmt --config .oxfmtrc.json --check apps packages"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.2",
		"@marioparaschiv/oxc-config": "^0.2.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"dts-bundle-generator": "^9.5.1",
		"eslint-plugin-jsdoc": "^64.5.4",
		"eslint-plugin-perfectionist": "^5.9.1",
		"eslint-plugin-unicorn": "^76.0.0",
		"lefthook": "^2.1.9",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"ts-morph": "^28.0.0"
	},
	"overrides": {
		"typescript": "5.9.3"
	},
	"trustedDependencies": [
		"lefthook"
	]
}
