{
	"defaultBridgePort": 9090,
	"controllerEndpointMarker": "mcp",
	"addressSetting": { "store": "unbound", "key": "debugger.address" },
	"frames": {
		"evalRequest": { "type": "eval", "id": "eval-1", "code": "1 + 1", "timeout": 5000 },
		"evalOk": { "type": "eval-result", "id": "eval-1", "ok": true, "value": "2" },
		"evalError": {
			"type": "eval-result",
			"id": "eval-1",
			"ok": false,
			"error": "Timed out",
			"code": "timeout"
		},
		"deviceConnected": {
			"type": "device-status",
			"connected": true,
			"device": {
				"platform": "ios",
				"discordVersion": "300.0",
				"loaderVersion": "1.0.0",
				"clientVersion": "1.0.0"
			}
		},
		"deviceDisconnected": { "type": "device-status", "connected": false }
	},
	"commandErrorCodes": [
		"invalid-input",
		"no-device",
		"device-disconnected",
		"timeout",
		"bridge-unreachable",
		"shut-down",
		"device-error",
		"not-found",
		"tool-failed",
		"unsupported",
		"command-failed"
	],
	"cliFailures": {
		"coded": {
			"ok": false,
			"text": "No device is connected to the debugger. Start the bridge.",
			"error": {
				"code": "no-device",
				"message": "No device is connected to the debugger.",
				"hint": "Start the bridge."
			}
		},
		"invalidInput": {
			"ok": false,
			"text": "must be >= 1 (at /timeout)",
			"error": {
				"code": "invalid-input",
				"message": "must be >= 1 (at /timeout)",
				"field": "timeout"
			}
		},
		"withData": {
			"summary": { "errors": 1 },
			"error": { "code": "command-failed", "message": "1 error." }
		}
	}
}
