{
	"name": "@unbound-app/cli",
	"version": "0.12.0",
	"description": "The `ubd` command line for the Unbound client: evaluate on-device code and serve the debugger as an MCP.",
	"author": {
		"name": "Mario P.",
		"email": "contact@marioparaschiv.com",
		"url": "https://github.com/marioparaschiv"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marioparaschiv/unbound.git",
		"directory": "packages/cli"
	},
	"bin": {
		"ubd": "src/index.ts"
	},
	"files": [
		"dist",
		"templates"
	],
	"type": "module",
	"module": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./rollup": "./src/rollup/index.ts"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "bun run --filter @unbound-app/web build:types && tsc --noEmit -p ."
	},
	"dependencies": {
		"@babel/core": "^7.29.7",
		"@babel/plugin-transform-block-scoping": "^8.0.8",
		"@clack/prompts": "^1.7.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@unbound-app/debugger-protocol": "workspace:*",
		"@unbound-app/rollup-plugin-hermes": "^1.3.0",
		"better-auth": "catalog:",
		"cleye": "^2.7.0",
		"picocolors": "^1.1.1",
		"rollup": "^4.65.1",
		"rollup-plugin-iife": "^0.8.0",
		"rollup-plugin-swc3": "^0.12.1",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@unbound-app/api": "workspace:*",
		"@unbound-app/contracts": "workspace:*",
		"@unbound-app/types": "workspace:*",
		"@unbound-app/utils": "workspace:*",
		"@unbound-app/web": "workspace:*",
		"tsdown": "^0.23.2"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	}
}
