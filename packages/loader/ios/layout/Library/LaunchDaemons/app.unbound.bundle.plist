<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.unbound.bundle</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/libexec/unbound-bundle</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>RunAtLoad</key>
	<true/>
	<key>WatchPaths</key>
	<array>
		<string>/var/containers/Bundle/Application</string>
	</array>
	<key>LaunchEvents</key>
	<dict>
		<key>com.apple.notifyd.matching</key>
		<dict>
			<key>app.unbound.bundle.sync</key>
			<dict>
				<key>Notification</key>
				<string>app.unbound.bundle.sync</string>
			</dict>
		</dict>
	</dict>
	<key>ThrottleInterval</key>
	<integer>2</integer>
</dict>
</plist>
