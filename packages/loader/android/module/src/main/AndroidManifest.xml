<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.discord" />
        <package android:name="de.robv.android.xposed.installer" />
        <package android:name="org.meowcat.edxposed.manager" />
        <package android:name="com.solohsu.android.edxp.manager" />
        <package android:name="top.canyie.dreamland.manager" />
    </queries>

    <application android:label="Unbound">
        <meta-data
            android:name="xposeddescription"
            android:value="Bridges Unbound into Discord's native layer." />

        <activity
            android:name=".StatusActivity"
            android:exported="true"
            android:label="Unbound"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>

</manifest>
