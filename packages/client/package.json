	"private": true,
	"author": {
		"name": "Mario P.",
		"email": "contact@marioparaschiv.com",
		"url": "https://github.com/marioparaschiv"
	},
	"scripts": {
		"build": "bun --bun scripts/build/index.ts",
		"build:dev": "bun --bun scripts/build/index.ts --dev",
		"dev": "bun --bun scripts/dev",
		"serve": "bun scripts/serve/start.ts",
		"upload": "bun scripts/build/upload.ts",
		"backfill-signatures": "bun scripts/build/backfill-signatures.ts",
		"verify-signatures": "bun scripts/build/verify-signatures.ts",
		"symbolicate": "bun scripts/build/symbolicate.ts",
		"typecheck": "bun run --filter @unbound-app/web build:types && tsc --noEmit -p ."
	},
	"dependencies": {
		"@unbound-app/contracts": "workspace:*",
		"@unbound-app/debugger-protocol": "workspace:*",
		"@unbound-app/logger": "workspace:*",
		"@unbound-app/types": "workspace:*",
		"@unbound-app/utils": "workspace:*",
		"@unbound-app/web": "workspace:*",
		"possess": "catalog:",
		"zustand": "^5.0.10"
	},
	"devDependencies": {
		"@jridgewell/trace-mapping": "^0.3.31",
		"@swc/core": "^1.15.10",
		"@types/bun": "catalog:",
		"@types/react": "catalog:react",
		"react": "catalog:react",
		"react-native": "catalog:react",
		"react-native-gesture-handler": "^3.4.0",
		"react-native-reanimated": "^4.2.1",
		"react-refresh": "^0.19.0"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	}
