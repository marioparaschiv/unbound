{
	"extends": "../../../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"composite": false,
		"module": "Preserve",
		"verbatimModuleSyntax": true,
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"types": ["bun", "@unbound-app/types"],
		"paths": {
			"~/*": ["../../src/*"],
			"@i18n/*": ["../../../../i18n/*"]
		}
	},
	"exclude": ["tests/build-output.test.ts", "tests/plugins/refresh.test.ts"]
}
