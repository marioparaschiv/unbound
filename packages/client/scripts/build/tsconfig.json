{
	"extends": "../../../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"composite": false,
		"module": "Preserve",
		"verbatimModuleSyntax": true,
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"types": ["bun", "@unbound-app/types"],
		"paths": {
			"~/*": ["../../src/*"],
			"@i18n/*": ["../../../../i18n/*"]
		}
	},
	// These tests import `~/hot-refresh/runtime`, which pulls client sources that fail this config's
	// stricter `noImplicitAny` and `noUncheckedIndexedAccess`; `packages/client` typechecks them instead.
	"exclude": ["tests/build-output.test.ts", "tests/plugins/refresh.test.ts"]
}
