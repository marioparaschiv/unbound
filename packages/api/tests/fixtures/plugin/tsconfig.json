{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext"],
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"types": ["bun"],
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["src", "tests", "settings.ts"]
}
