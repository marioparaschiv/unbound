{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": [
		"./node_modules/@marioparaschiv/oxc-config/base.json",
		"./node_modules/@marioparaschiv/oxc-config/react.json",
		"./node_modules/@marioparaschiv/oxc-config/jsdoc.json"
	],
	"plugins": ["unicorn", "typescript", "oxc", "react", "import"],
	"jsPlugins": [
		{
			"name": "unbound",
			"specifier": "./scripts/oxlint/plugin.ts"
		}
	],
	"rules": {
		"react-hooks/rules-of-hooks": "error",
		"react/jsx-key": "error",
		"react/immutability": "off",
		"react/set-state-in-effect": "off",
		"react-hooks/exhaustive-deps": "off",
		"import/no-duplicates": "error",
		"import/first": "error",
		"import/no-self-import": "error",
		"no-var": "error",
		"prefer-const": "error",
		"eqeqeq": "error",
		"unicorn/prefer-node-protocol": "error",
		"typescript/switch-exhaustiveness-check": [
			"error",
			{
				"considerDefaultExhaustiveForUnions": true
			}
		],
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/no-misused-promises": [
			"error",
			{
				"checksVoidReturn": {
					"attributes": false
				}
			}
		],
		"oxc-config/consistent-import-paths": [
			"error",
			{
				"alias": "~/",
				"aliasRoots": ["packages/*/src", "apps/*/src"],
				"relativeRoots": ["packages/plugins-shared/src"]
			}
		],
		"unbound/max-file-bytes": "error",
		"unbound/no-asserted-external-data": "error",
		"unbound/no-pass-through-wrapper": "error",
		"unbound/no-env-mutation": "error",
		"unbound/prefer-discriminated-union": "error",
		"unbound/no-upward-imports": [
			"error",
			{
				"layers": [
					{
						"from": ["packages/client/src/api"],
						"deny": ["~/ui", "~/builtins", "~/managers"],
						"except": ["packages/client/src/api/index.ts"],
						"because": "client `api/` is the public capability layer below `ui/`, `builtins/` and `managers/`"
					},
					{
						"from": ["packages/client/src/lib"],
						"deny": ["~/ui", "~/builtins", "~/managers", "~/stores"],
						"because": "client `lib/` is internal infrastructure below every feature layer"
					},
					{
						"from": ["packages/client/src/managers", "packages/client/src/stores"],
						"deny": ["~/ui"],
						"because": "managers and stores hold state that `ui/` renders, never the reverse"
					},
					{
						"from": ["packages/client/src/ui"],
						"deny": ["~/builtins"],
						"because": "`ui/` components must not depend on builtins wired in at startup"
					},
					{
						"from": ["packages/cli/src/lib"],
						"deny": ["~/registry", "~/commands", "~/adapters"],
						"because": "cli `lib/` sits below the commands, their registry and the adapters that run them"
					},
					{
						"from": ["apps/web/src/db"],
						"deny": [
							"~/lib",
							"~/endpoints",
							"~/components",
							"~/queries",
							"~/routes",
							"~/hooks"
						],
						"because": "web `db/` is the bottom layer"
					},
					{
						"from": ["apps/web/src/lib", "apps/web/src/endpoints", "apps/web/src/api"],
						"deny": ["~/components", "~/queries", "~/routes", "~/hooks"],
						"because": "server code must not depend on client UI"
					},
					{
						"from": [
							"apps/web/src/components",
							"apps/web/src/queries",
							"apps/web/src/hooks"
						],
						"deny": ["~/db", "~/lib/app", "~/endpoints"],
						"because": "client UI reaches the server through server functions in `queries/`, never the database or endpoints"
					},
					{
						"from": ["apps/discord-bot/src/lib"],
						"deny": ["~/dispatchers", "~/db", "~/commands", "~/listeners", "~/runtime"],
						"because": "bot `lib/` sits below the features that use it"
					},
					{
						"from": [
							"packages/types/src",
							"packages/types/typings",
							"packages/utils/src",
							"packages/logger/src",
							"packages/contracts/src",
							"packages/debugger-protocol/src"
						],
						"deny": [
							"@unbound-app/cli",
							"@unbound-app/client",
							"@unbound-app/debugger",
							"@unbound-app/web"
						],
						"because": "shared packages sit below the apps and tools that consume them"
					}
				]
			}
		]
	},
	"ignorePatterns": [
		"dist",
		"*.gen.ts",
		"packages/api/src/**",
		"packages/discord-types/src/**",
		"packages/cli/templates/**",
		"packages/plugins/**",
		"packages/plugin-scripts/**",
		"packages/loader/bootstrap/devtools.js",
		"packages/loader/vendor/**",
		"packages/loader/apt-repo/**",
		"packages/loader/ios/**",
		"packages/loader/android/**",
		"packages/loader/build/**"
	],
	"overrides": [
		{
			"files": ["packages/client/src/api/metro/**", "packages/types/typings/components.ts"],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": ["packages/loader/bootstrap/*.js"],
			"rules": {
				"eslint/no-unused-expressions": "off"
			}
		},
		{
			"files": ["packages/plugins-shared/src/native/app-surface.ts"],
			"rules": {
				"typescript/no-implied-eval": "off"
			}
		},
		{
			"files": ["packages/*/src/**", "apps/*/src/**"],
			"rules": {
				"unbound/no-import-outside-package": "error"
			}
		}
	]
}
