{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": [
		"./node_modules/@marioparaschiv/oxc-config/base.json",
		"./node_modules/@marioparaschiv/oxc-config/react.json",
		"./node_modules/@marioparaschiv/oxc-config/jsdoc.json"
	],
	"plugins": ["unicorn", "typescript", "oxc", "react", "import"],
	"jsPlugins": [
		{
			"name": "unbound",
			"specifier": "./scripts/oxlint/plugin.ts"
		}
	],
	"rules": {
		"react-hooks/rules-of-hooks": "error",
		"react/jsx-key": "error",
		"react/immutability": "off",
		"react/set-state-in-effect": "off",
		"react-hooks/exhaustive-deps": "off",
		"import/no-duplicates": "error",
		"import/first": "error",
		"import/no-self-import": "error",
		"no-var": "error",
		"prefer-const": "error",
		"eqeqeq": "error",
		"unicorn/prefer-node-protocol": "error",
		"typescript/switch-exhaustiveness-check": [
			"error",
			{
				"considerDefaultExhaustiveForUnions": true
			}
		],
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/no-misused-promises": [
			"error",
			{
				"checksVoidReturn": {
					"attributes": false
				}
			}
		],
		"oxc-config/consistent-import-paths": [
			"error",
			{
				"alias": "~/",
				"aliasRoots": ["packages/*/src", "apps/*/src"],
				"relativeRoots": ["packages/plugins-shared/src"]
			}
		],
		"unbound/max-file-bytes": "error",
		"unbound/no-asserted-external-data": "error",
		"unbound/no-pass-through-wrapper": "error",
		"unbound/no-env-mutation": "error",
		"unbound/prefer-discriminated-union": "error",
		"unbound/no-upward-imports": [
			"error",
			{
				"layers": [
					{
						"from": [
							"packages/client/src/core",
							"packages/client/src/metro",
							"packages/client/src/flux",
							"packages/client/src/patcher",
							"packages/client/src/commands",
							"packages/client/src/storage",
							"packages/client/src/native",
							"packages/client/src/assets",
							"packages/client/src/i18n",
							"packages/client/src/toasts",
							"packages/client/src/settings",
							"packages/client/src/addons",
							"packages/client/src/plugins",
							"packages/client/src/themes",
							"packages/client/src/icon-packs",
							"packages/client/src/fonts",
							"packages/client/src/marketplace",
							"packages/client/src/updates",
							"packages/client/src/sync",
							"packages/client/src/builtins",
							"packages/client/src/debugger",
							"packages/client/src/hot-refresh",
							"packages/client/src/dialogs",
							"packages/client/src/diagnostics",
							"packages/client/src/links"
						],
						"deny": ["~/ui"],
						"except": [
							"packages/client/src/assets/builtin.ts",
							"packages/client/src/commands/builtin.ts",
							"packages/client/src/debugger/builtin.ts",
							"packages/client/src/hot-refresh/builtin.ts",
							"packages/client/src/i18n/builtin.ts",
							"packages/client/src/links/builtin.ts",
							"packages/client/src/marketplace/builtin.ts",
							"packages/client/src/native/builtin.ts",
							"packages/client/src/plugins/builtin.ts",
							"packages/client/src/settings/builtin.tsx",
							"packages/client/src/sync/builtin.ts",
							"packages/client/src/themes/builtin.ts",
							"packages/client/src/toasts/builtin.tsx",
							"packages/client/src/updates/builtin.ts",
							"packages/client/src/builtins/error-boundary.tsx",
							"packages/client/src/core/api.ts"
						],
						"because": "only a domain's `builtin.ts(x)`, and the public barrel for the `ui` namespace, may import `ui/`; `ui/` imports domains, never the reverse (D14)"
					},
					{
						"from": ["packages/client/src/ui"],
						"deny": [
							"~/builtins",
							"~/assets/builtin",
							"~/commands/builtin",
							"~/debugger/builtin",
							"~/hot-refresh/builtin",
							"~/i18n/builtin",
							"~/links/builtin",
							"~/marketplace/builtin",
							"~/native/builtin",
							"~/plugins/builtin",
							"~/settings/builtin",
							"~/sync/builtin",
							"~/themes/builtin",
							"~/toasts/builtin",
							"~/updates/builtin"
						],
						"because": "`ui/` components must not depend on builtins wired in at startup"
					},
					{
						"from": ["packages/cli/src/lib"],
						"deny": ["~/registry", "~/commands", "~/adapters"],
						"because": "cli `lib/` sits below the commands, their registry and the adapters that run them"
					},
					{
						"from": ["apps/web/src/db"],
						"deny": [
							"~/lib",
							"~/endpoints",
							"~/components",
							"~/queries",
							"~/routes",
							"~/hooks"
						],
						"because": "web `db/` is the bottom layer"
					},
					{
						"from": ["apps/web/src/lib", "apps/web/src/endpoints", "apps/web/src/api"],
						"deny": ["~/components", "~/queries", "~/routes", "~/hooks"],
						"because": "server code must not depend on client UI"
					},
					{
						"from": [
							"apps/web/src/components",
							"apps/web/src/queries",
							"apps/web/src/hooks"
						],
						"deny": ["~/db", "~/lib/app", "~/endpoints"],
						"because": "client UI reaches the server through server functions in `queries/`, never the database or endpoints"
					},
					{
						"from": ["apps/discord-bot/src/lib"],
						"deny": ["~/dispatchers", "~/db", "~/commands", "~/listeners", "~/runtime"],
						"because": "bot `lib/` sits below the features that use it"
					},
					{
						"from": [
							"packages/types/src",
							"packages/types/typings",
							"packages/utils/src",
							"packages/logger/src",
							"packages/contracts/src",
							"packages/debugger-protocol/src"
						],
						"deny": [
							"@unbound-app/cli",
							"@unbound-app/client",
							"@unbound-app/debugger",
							"@unbound-app/web"
						],
						"because": "shared packages sit below the apps and tools that consume them"
					}
				]
			}
		]
	},
	"ignorePatterns": [
		"dist",
		"*.gen.ts",
		"packages/api/src/**",
		"packages/discord-types/src/**",
		"packages/cli/templates/**",
		"packages/plugins/**",
		"packages/plugin-scripts/**",
		"packages/loader/bootstrap/devtools.js",
		"apps/devtools/harness/**",
		"apps/devtools/target/**",
		"packages/loader/vendor/**",
		"packages/loader/apt-repo/**",
		"packages/loader/ios/**",
		"packages/loader/android/**",
		"packages/loader/build/**"
	],
	"overrides": [
		{
			"files": [
				"packages/client/src/metro/{api.ts,common.ts,components.ts,design.ts,fallbacks/**,filters.ts,finders.ts,index.ts,invalid-exports.ts,lazy-registry.ts,registry.ts,search.ts,state.ts,stores.ts,types.ts,wrappers.ts}",
				"packages/types/typings/components.ts"
			],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": ["packages/client/src/**"],
			"rules": {
				"react/no-multi-comp": "error",
				"react/no-unstable-nested-components": "error",
				"react/jsx-no-constructed-context-values": "error",
				"react/no-object-type-as-default-prop": "error",
				"react/function-component-definition": "error",
				"import/no-cycle": "error"
			}
		},
		{
			"files": ["packages/loader/bootstrap/*.js"],
			"rules": {
				"eslint/no-unused-expressions": "off"
			}
		},
		{
			"files": ["packages/plugins-shared/src/native/app-surface.ts"],
			"rules": {
				"typescript/no-implied-eval": "off"
			}
		},
		{
			"files": ["packages/*/src/**", "apps/*/src/**"],
			"rules": {
				"unbound/no-import-outside-package": "error"
			}
		}
	]
}
