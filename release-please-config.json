{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"bootstrap-sha": "9b5f711242bb9cc693f53316282eb0241039ae55",
	"include-component-in-tag": true,
	"changelog-sections": [
		{ "type": "feat", "section": "Features" },
		{ "type": "fix", "section": "Bug Fixes" },
		{ "type": "perf", "section": "Performance Improvements" },
		{ "type": "revert", "section": "Reverts" },
		{ "type": "refactor", "section": "Code Refactoring", "hidden": true },
		{ "type": "build", "section": "Build System", "hidden": true },
		{ "type": "docs", "section": "Documentation", "hidden": true },
		{ "type": "style", "section": "Styles", "hidden": true },
		{ "type": "test", "section": "Tests", "hidden": true },
		{ "type": "ci", "section": "Continuous Integration", "hidden": true },
		{ "type": "chore", "section": "Miscellaneous Chores", "hidden": true }
	],
	"packages": {
		"packages/client": {
			"component": "client",
			"release-as": "1.0.0",
			"exclude-paths": [
				"packages/client/tests",
				"packages/client/scripts/dev",
				"packages/client/scripts/serve",
				"packages/client/scripts/bench-android"
			]
		},
		"packages/api": { "component": "api", "release-as": "1.0.0" },
		"packages/cli": { "component": "cli", "release-as": "1.0.0" },
		"packages/debugger": { "component": "debugger" },
		"packages/debugger-protocol": { "component": "debugger-protocol" },
		"packages/discord-types": { "component": "discord-types" },
		"packages/rollup-plugin-hermes": {
			"component": "rollup-plugin-hermes",
			"release-as": "1.0.0"
		},
		"apps/devtools": {
			"component": "devtools",
			"release-type": "simple",
			"initial-version": "0.1.0",
			"extra-files": [
				{
					"type": "toml",
					"path": "Cargo.toml",
					"jsonpath": "$.workspace.package.version"
				},
				{
					"type": "toml",
					"path": "Cargo.lock",
					"jsonpath": "$.package[?(@.name.value==='unbound-devtools' || @.name.value==='unbound-devtools-core' || @.name.value==='unbound-devtools-repl')].version"
				}
			]
		}
	},
	"plugins": [
		{ "type": "node-workspace", "merge": false },
		{ "type": "linked-versions", "groupName": "client", "components": ["client", "api"] }
	]
}
