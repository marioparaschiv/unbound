{
	"name": "@unbound-app/discord-bot",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun scripts/migrate.ts && bun --watch src/index.ts",
		"start": "bun scripts/migrate.ts && bun src/index.ts",
