		"@sapphire/plugin-logger": "^4.1.0",
		"@sapphire/plugin-subcommands": "^7.0.1",
		"@unbound-app/contracts": "workspace:*",
		"@unbound-app/logger": "workspace:*",
		"colorette": "^2.0.20",
		"discord.js": "^14.27.0",
		"drizzle-orm": "1.0.0-rc.4",
		"postgres": "^3.4.9",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"drizzle-kit": "1.0.0-rc.4"
	},
