{
	"name": "@unbound-app/web",
	"version": "0.10.0",
	"private": true,
	"type": "module",
	"exports": {
		"./api": {
			"types": "./dist/types/src/api/index.d.ts",
			"default": "./src/api/index.ts"
		},
		"./client": {
			"types": "./dist/types/src/api/client.d.ts",
			"default": "./src/api/client.ts"
		},
		"./testing": {
			"types": "./dist/types/tests/helpers/index.d.ts",
			"default": "./tests/helpers/index.ts"
		}
	},
	"scripts": {
		"dev": "bun scripts/migrate.ts && bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "bun scripts/migrate.ts && bun scripts/serve.ts",
		"typecheck": "tsc --noEmit -p .",
		"build:types": "tsc -p tsconfig.types.json && bun scripts/resolve-type-paths.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"b2:staging-lifecycle": "b2 bucket update --lifecycle-rule \"$(cat b2/staging-lifecycle.json)\" \"$S3_STAGING_BUCKET\" allPrivate"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@better-auth/api-key": "1.7.10",
		"@better-auth/drizzle-adapter": "1.7.10",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tabler/icons-react": "^3.37.1",
		"@tanstack/history": "1.162.5",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-router": "1.170.45",
		"@tanstack/react-start": "1.169.3",
		"@tanstack/router-core": "1.171.38",
		"@unbound-app/contracts": "workspace:*",
		"@unbound-app/logger": "workspace:*",
		"@unbound-app/utils": "workspace:*",
		"better-auth": "catalog:",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"diff": "^9.0.0",
		"drizzle-orm": "1.0.0-rc.4",
		"motion": "^14.6.0",
		"obscenity": "^0.4.6",
		"react": "catalog:react",
		"react-day-picker": "^10.0.2",
		"react-dom": "catalog:react",
		"react-markdown": "^10.1.0",
		"recharts": "3.7.0",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"vaul": "^1.1.2",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.0",
		"@types/bun": "catalog:",
		"@types/react": "catalog:react",
		"@types/react-dom": "catalog:react",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "1.0.0-rc.4",
		"tailwindcss": "^4.2.0",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.3.4"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	}
}
